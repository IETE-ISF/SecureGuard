# SecureRack Guardian - environment template.
# Copy to .env and adjust. Never commit the real .env file.

SRG_APP_NAME=SecureRack Guardian
SRG_ENVIRONMENT=development
SRG_DEBUG=true

SRG_HOST=0.0.0.0
SRG_PORT=8000

SRG_LOG_LEVEL=DEBUG
SRG_LOG_DIR=backend/logs

SRG_DATABASE_PATH=data/securerack.db
SRG_DATABASE_ECHO=false

# UART link to the master ESP32-C3 (Windows example: COM5, Raspberry Pi: /dev/serial0)
SRG_UART_ENABLED=false
SRG_UART_PORT=
SRG_UART_BAUDRATE=115200
SRG_UART_READ_TIMEOUT=1.0

# Mark a device offline after this many silent seconds; how often to check
SRG_DEVICE_OFFLINE_TIMEOUT_SECONDS=30
SRG_DEVICE_SWEEP_INTERVAL_SECONDS=10
